#!/usr/bin/env bash
# meeting-recorder: install, update, repair and remove Meeting Recorder (macOS).
#
#   ~/.meeting-recorder/
#     app/            this repository (the daemon runs from apps/daemon/src)
#     runtime/node    pinned Node.js (SHA-256 verified), never the system/brew/nvm Node
#     bin/            the meeting-recorder command
#     agent.json      tells the menu-bar app where Node and the daemon are
#     logs/           agent.log, daemon.log
#   ~/Applications/Meeting Recorder.app       built and signed on this Mac
#   ~/Library/LaunchAgents/com.meetingrecorder.agent.plist   starts it at login
#   ~/Meetings/       your recordings (never touched by update or uninstall)
set -Eeuo pipefail # -E: ERR traps also fire inside functions (update's rollback depends on it)

HOME_DIR="${MR_HOME:-$HOME/.meeting-recorder}"
APP_SRC="$HOME_DIR/app"
APPS_DIR="${MR_APPS_DIR:-$HOME/Applications}"
APP_BUNDLE="$APPS_DIR/Meeting Recorder.app"
MEETINGS_DIR="${MR_MEETINGS_DIR:-$HOME/Meetings}"
LABEL="com.meetingrecorder.agent"
PLIST="${MR_LAUNCH_AGENTS_DIR:-$HOME/Library/LaunchAgents}/$LABEL.plist"
SIGNING_IDENTITY="Meeting Recorder Local Signing"
NODE_URL_BASE="${MR_NODE_URL_BASE:-https://nodejs.org/dist}"

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33mwarning:\033[0m %s\n' "$*" >&2; }
die() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

script_dir() { cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P; }

# ---------------------------------------------------------------- Node runtime (pinned + verified)

node_arch() {
  case "$(uname -m)" in
    arm64) echo darwin-arm64 ;;
    x86_64) echo darwin-x64 ;;
    *) die "unsupported CPU $(uname -m)" ;;
  esac
}

# Prints the path of a verified Node binary, downloading it if needed.
ensure_node() {
  local src="$1" pins version arch expected dir tarball actual
  pins="$src/scripts/node-version.txt"
  version="$(grep '^version=' "$pins" | cut -d= -f2)"
  arch="$(node_arch)"
  expected="$(grep "^$arch=" "$pins" | cut -d= -f2)"
  dir="$HOME_DIR/runtime/node-$version-$arch"
  if [ -x "$dir/bin/node" ]; then echo "$dir/bin/node"; return; fi

  say "Downloading Node.js $version ($arch)…" >&2
  mkdir -p "$HOME_DIR/runtime"
  tarball="$(mktemp "$HOME_DIR/runtime/node.XXXXXX")"
  curl -fsSL "$NODE_URL_BASE/$version/node-$version-$arch.tar.gz" -o "$tarball" || { rm -f "$tarball"; die "Node.js download failed."; }
  actual="$(shasum -a 256 "$tarball" | cut -d' ' -f1)"
  if [ "$actual" != "$expected" ]; then
    rm -f "$tarball"
    die "Node.js checksum mismatch (expected $expected, got $actual). Not installing."
  fi
  mkdir -p "$dir.tmp"
  tar -xzf "$tarball" -C "$dir.tmp" --strip-components 1
  rm -f "$tarball"
  rm -rf "$dir"
  mv "$dir.tmp" "$dir"
  echo "$dir/bin/node"
}

# ---------------------------------------------------------------- building

# Builds dependencies, dashboard and agent inside $1. Nothing outside $1 is touched.
build_tree() {
  local src="$1" node="$2" bundle_out="$3" npm
  npm="$(dirname "$node")/npm"
  # Each step checks its own status: callers use `if ! build_tree`, where bash disables `set -e`.
  say "Installing dependencies…"
  (cd "$src" && PATH="$(dirname "$node"):$PATH" "$npm" ci --no-audit --no-fund --loglevel=error) || return 1
  say "Building the dashboard…"
  (cd "$src" && PATH="$(dirname "$node"):$PATH" "$npm" run build --workspace @meeting-recorder/web --silent) || return 1
  [ -f "$src/apps/web/dist/index.html" ] || return 1
  say "Building the menu-bar app (this takes a minute)…"
  "$src/scripts/build-agent.sh" "$src" "$bundle_out" || return 1
}

write_agent_config() {
  local node="$1"
  mkdir -p "$HOME_DIR/logs"
  cat > "$HOME_DIR/agent.json.tmp" <<EOF
{
  "nodePath": "$node",
  "daemonEntry": "$APP_SRC/apps/daemon/src/index.ts",
  "webDist": "$APP_SRC/apps/web/dist",
  "meetingsDir": "$MEETINGS_DIR",
  "home": "$HOME_DIR"
}
EOF
  mv "$HOME_DIR/agent.json.tmp" "$HOME_DIR/agent.json"
}

write_launch_agent() {
  mkdir -p "$(dirname "$PLIST")"
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$APP_BUNDLE/Contents/MacOS/MeetingRecorderAgent</string></array>
  <key>AssociatedBundleIdentifiers</key><array><string>$LABEL</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardErrorPath</key><string>$HOME_DIR/logs/agent.stderr.log</string>
</dict>
</plist>
EOF
}

# launchd: bootout BEFORE replacing files (KeepAlive would otherwise relaunch the old app mid-swap).
agent_stop() { launchctl bootout "gui/$(id -u)/$LABEL" >/dev/null 2>&1 || true; }
agent_start() { launchctl bootstrap "gui/$(id -u)" "$PLIST"; }

install_cli() {
  mkdir -p "$HOME_DIR/bin"
  ln -sf "$APP_SRC/scripts/meeting-recorder" "$HOME_DIR/bin/meeting-recorder"
  # shellcheck disable=SC2016  # written literally; expanded later by the user's shell
  local line='export PATH="$HOME/.meeting-recorder/bin:$PATH"'
  local profile="$HOME/.zprofile"
  if ! grep -qsF "$line" "$profile"; then
    printf '\n# Meeting Recorder\n%s\n' "$line" >> "$profile"
  fi
}

offer_signing_identity() {
  if security find-identity -v -p codesigning 2>/dev/null | grep -q "$SIGNING_IDENTITY"; then return; fi
  [ -t 0 ] || { warn "No terminal: skipping the local signing certificate (permissions will reset on each update)."; return; }
  printf '\nMeeting Recorder can create a local code-signing certificate so macOS keeps its Screen Recording\n'
  printf 'and Microphone permissions across updates. macOS will ask for your password twice. Create it? [Y/n] '
  local answer
  read -r answer
  case "$answer" in
    n|N|no|No) warn "Skipped. After each update you'll need to re-allow Screen Recording." ;;
    *) "$APP_SRC/scripts/create-signing-cert.sh" || warn "Certificate setup failed; using ad-hoc signing." ;;
  esac
}

# ---------------------------------------------------------------- daemon API (for update/status)

daemon_status() {
  local runtime="$HOME_DIR/runtime.json" port token
  [ -f "$runtime" ] || return 1
  port="$(/usr/bin/plutil -extract port raw -o - "$runtime" 2>/dev/null)" || return 1
  token="$(/usr/bin/plutil -extract token raw -o - "$runtime" 2>/dev/null)" || return 1
  curl -fsS --max-time 3 -H "Authorization: Bearer $token" "http://127.0.0.1:$port/api/status"
}

is_recording() {
  daemon_status 2>/dev/null | grep -qE '"state":"(starting|recording|stopping)"'
}

# ---------------------------------------------------------------- commands

cmd_install_local() {
  [ -d "$APP_SRC/.git" ] || die "run the installer: curl -fsSL https://raw.githubusercontent.com/Ruhithpasha/meeting-recorder/main/scripts/install.sh | bash"
  local node
  node="$(ensure_node "$APP_SRC")"
  offer_signing_identity
  mkdir -p "$APPS_DIR" "$MEETINGS_DIR"
  build_tree "$APP_SRC" "$node" "$APP_BUNDLE" || die "The build failed. Fix the error above and run: meeting-recorder repair"
  write_agent_config "$node"
  write_launch_agent
  install_cli
  agent_stop
  agent_start
  say "Installed. Look for the record icon in your menu bar."
  printf '\nmacOS will now ask Meeting Recorder for Screen Recording and Microphone access. Allow both,\n'
  printf 'then choose Quit and reopen Meeting Recorder (or log out and in) once so Screen Recording applies.\n'
  printf '\nCommands: meeting-recorder status | open | update | repair | logs | uninstall\n'
  printf 'Recordings: %s\n' "$MEETINGS_DIR"
}

# Atomic update: everything is built in a staging copy; the live install is only replaced once
# every step has succeeded, so a failed build (e.g. Command Line Tools broken by a macOS update)
# leaves the working version running.
cmd_update() {
  [ -d "$APP_SRC/.git" ] || die "Meeting Recorder isn't installed."
  if is_recording; then die "A meeting is being recorded. Update after it ends."; fi
  local staging="$HOME_DIR/app-next" bundle_next="$HOME_DIR/Meeting Recorder.app.next" node
  rm -rf "$staging" "$bundle_next"
  # Expanded now (double quotes): these locals are gone when the EXIT trap runs.
  trap "rm -rf '$staging' '$bundle_next'" EXIT

  say "Fetching the latest version…"
  git clone --quiet --depth 1 --branch "${MR_REF:-main}" "$(git -C "$APP_SRC" remote get-url origin)" "$staging"
  if [ "$(git -C "$staging" rev-parse HEAD)" = "$(git -C "$APP_SRC" rev-parse HEAD)" ]; then
    say "Already up to date."
    return 0
  fi

  node="$(ensure_node "$staging")"
  if ! build_tree "$staging" "$node" "$bundle_next"; then
    die "Update failed while building. Your current version is untouched and still running."
  fi

  say "Switching to the new version…"
  local prev="$HOME_DIR/app-prev" bundle_prev="$APP_BUNDLE.prev"
  rm -rf "$prev" "$bundle_prev"
  agent_stop
  # From here on, any failure restores the previous version and restarts it.
  trap "rollback_update '$prev' '$bundle_prev' '$staging' '$bundle_next'" ERR
  mv "$APP_SRC" "$prev"
  mv "$staging" "$APP_SRC"
  if [ -d "$APP_BUNDLE" ]; then mv "$APP_BUNDLE" "$bundle_prev"; fi
  mv "$bundle_next" "$APP_BUNDLE"
  write_agent_config "$node"
  write_launch_agent
  agent_start
  trap - ERR EXIT
  rm -rf "$prev" "$bundle_prev"
  say "Updated to $(git -C "$APP_SRC" rev-parse --short HEAD)."
}

rollback_update() {
  local prev="$1" bundle_prev="$2" staging="$3" bundle_next="$4"
  trap - ERR
  warn "Switching versions failed. Restoring the previous version…"
  if [ -d "$prev" ]; then rm -rf "$APP_SRC"; mv "$prev" "$APP_SRC"; fi
  if [ -d "$bundle_prev" ]; then rm -rf "$APP_BUNDLE"; mv "$bundle_prev" "$APP_BUNDLE"; fi
  rm -rf "$staging" "$bundle_next"
  agent_start || true
  die "Update failed; the previous version was restored."
}

cmd_repair() {
  [ -d "$APP_SRC/.git" ] || die "Meeting Recorder isn't installed."
  if is_recording; then die "A meeting is being recorded. Repair after it ends."; fi
  local node
  node="$(ensure_node "$APP_SRC")"
  if [ ! -d "$APP_BUNDLE" ]; then build_tree "$APP_SRC" "$node" "$APP_BUNDLE" || die "Rebuilding the app failed."; fi
  write_agent_config "$node"
  write_launch_agent
  install_cli
  agent_stop
  agent_start
  say "Repaired. Node: $node"
}

cmd_uninstall() {
  if is_recording; then die "A meeting is being recorded. Stop it (menu bar > Stop Recording), then uninstall."; fi
  say "Removing Meeting Recorder (your recordings in $MEETINGS_DIR are kept)…"
  agent_stop
  rm -f "$PLIST"
  rm -rf "$APP_BUNDLE" "$HOME_DIR"
  if security find-identity -p codesigning 2>/dev/null | grep -q "$SIGNING_IDENTITY"; then
    security delete-identity -c "$SIGNING_IDENTITY" >/dev/null 2>&1 || warn "Remove the '$SIGNING_IDENTITY' certificate in Keychain Access if you like."
  fi
  sed -i '' '/# Meeting Recorder/d;/\.meeting-recorder\/bin/d' "$HOME/.zprofile" 2>/dev/null || true
  say "Uninstalled."
}

cmd_status() {
  local status
  if status="$(daemon_status 2>/dev/null)"; then echo "$status"; else echo "Meeting Recorder isn't running."; exit 1; fi
}

cmd_open() {
  local runtime="$HOME_DIR/runtime.json" port token
  [ -f "$runtime" ] || die "Meeting Recorder isn't running."
  port="$(/usr/bin/plutil -extract port raw -o - "$runtime")"
  token="$(/usr/bin/plutil -extract token raw -o - "$runtime")"
  open "http://127.0.0.1:$port/#t=$token"
}

cmd_logs() { tail -n 100 -F "$HOME_DIR/logs/agent.log" "$HOME_DIR/logs/daemon.log"; }

usage() {
  cat <<EOF
meeting-recorder <command>
  status      show whether it's recording
  open        open the dashboard
  update      install the latest version (keeps the current one if anything fails)
  repair      fix a broken install (re-verifies Node, rewrites config, restarts)
  logs        follow the logs
  uninstall   remove the app (keeps your recordings in $MEETINGS_DIR)
EOF
}

case "${1:-}" in
  install-local) cmd_install_local ;;
  update) cmd_update ;;
  repair) cmd_repair ;;
  uninstall) cmd_uninstall ;;
  status) cmd_status ;;
  open) cmd_open ;;
  logs) cmd_logs ;;
  -h|--help|help|"") usage ;;
  *) usage; exit 64 ;;
esac
